# Copiar a .env.local y completar. .env.local no se sube al repo.

# --- Modelo -----------------------------------------------------------------
# LLM_PROVIDER elige el proveedor: "openai" (compatible con OpenAI, por defecto)
# o "anthropic" (Claude con el SDK oficial).

# Opción A: Ollama en tu propio notebook
LLM_PROVIDER=openai
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b

# Opción B: el Spark. Reemplazar por su IP en la red local o su nombre en Tailscale.
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://spark:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=gpt-oss:20b

# Opción C: Claude en la nube. Es lo que usa el deploy público.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium
# ANTHROPIC_API_KEY=

# --- Salas (opcionales) -------------------------------------------------------
# Tope de salas en memoria creadas por POST /api/rooms. Por defecto 200.
# NEXO_MAX_ROOMS=200
# Clave de administración. Sirve en el encabezado x-admin-key para los controles
# de anfitrión de cualquier sala, y es la única forma de pedir los controles de
# una sala fija (POST /api/rooms/:id/host) en producción.
# NEXO_ADMIN_KEY=

# --- Límite de peticiones ------------------------------------------------------
# Detrás de un proxy (Render) poner TRUST_PROXY=1 para que el límite se cuente por
# IP del cliente (último salto de X-Forwarded-For). Sin esto, todos comparten un
# mismo límite: sigue protegiendo, pero más grueso. En local, dejarlo vacío.
# TRUST_PROXY=1
# NEXO_RATE_LIMITS=off apaga los límites. Solo para pruebas de carga locales.
# NEXO_RATE_LIMITS=

# --- Supabase (formulario de acceso y entrevistas de la portada) ---------------
# Opcional: sin estas variables, o sin las tablas, la portada sigue funcionando y
# el formulario responde que por ahora no puede guardar. Tablas en supabase/migrations/.
# La URL y la clave anon son públicas. La clave service_role se salta RLS: solo
# servidor, nunca con prefijo NEXT_PUBLIC_ ni en un componente de cliente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Canales externos del Comité (opcionales) ---------------------------------
# Sin estas variables los canales no aparecen (GET /api/integrations/status) y el
# Comité decide desde la web con el QR. Todas son solo de servidor.
#
# WhatsApp con Kapso: el caso llega con botones Aprobar / Vetar y la razón se
# responde por escrito. El webhook es /api/integrations/kapso/webhook.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
# Plantilla aprobada por Meta para iniciar la conversación con un número de
# producción (en la Sandbox no hace falta). Ej.: nexo_comite_caso
# KAPSO_TEMPLATE_NAME=
# KAPSO_TEMPLATE_LANG=es
# Secreto con que Kapso firma el webhook (encabezado X-Webhook-Signature, HMAC).
KAPSO_WEBHOOK_SECRET=
#
# Voz con ElevenLabs: un agente que llama por teléfono (número de Twilio
# vinculado en ElevenLabs) o conversa en el navegador.
ELEVENLABS_API_KEY=
# Opcional: si falta, el agente del Comité se crea la primera vez que se usa.
ELEVENLABS_AGENT_ID=
# Solo para llamadas: id del número de Twilio vinculado en ElevenLabs.
ELEVENLABS_PHONE_NUMBER_ID=
#
# Número del Comité en formato E.164 (+569...), para WhatsApp y para la llamada.
NEXO_COMMITTEE_PHONE=
# URL pública del deploy: ElevenLabs llama ahí a las herramientas del agente.
NEXO_PUBLIC_BASE_URL=
# Secreto compartido que ElevenLabs envía (encabezado x-nexo-secret) al llamar a las herramientas.
NEXO_CHANNEL_SECRET=
