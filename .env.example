# Copiar a .env.local y completar. .env.local no se sube al repo.

# --- Modelo (cualquier endpoint compatible con OpenAI) ---
# Opción A: Ollama en tu propio notebook (para desarrollar antes de tener el Spark)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gpt-oss:20b

# Opción B: el Spark. Reemplazar por su IP en la red local o su nombre en Tailscale.
# LLM_BASE_URL=http://spark:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=gpt-oss:20b

# Opción C: plan B en la nube. Cualquier proveedor compatible con OpenAI.
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- ElevenLabs (solo servidor, nunca con prefijo NEXT_PUBLIC_) ---
ELEVENLABS_API_KEY=
